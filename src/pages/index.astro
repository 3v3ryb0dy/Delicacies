---
import { getCollection, getEntry, render } from 'astro:content'
import RecipeCard from '../components/RecipeCard.astro'
import RecipeExplorer from '../components/RecipeExplorer.astro'
import { categories } from '../config/taxonomy'
import BaseLayout from '../layouts/BaseLayout.astro'

const recipes = (await getCollection('recipes')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'))

const byCategory = new Map(
  categories.map((category) => [category.id, recipes.filter((recipe) => recipe.data.category === category.id)])
)

const vorwort = await getEntry('seiten', 'vorwort')
const { Content: Vorwort } = await render(vorwort!)

const filledCategories = categories.filter((category) => (byCategory.get(category.id)?.length ?? 0) > 0)
const emptyCategories = categories.filter((category) => (byCategory.get(category.id)?.length ?? 0) === 0)

/** Empty subcategories of a category that does have recipes, e.g. Sättigungsbeilagen. */
const emptySubcategories = filledCategories.flatMap((category) =>
  (category.subcategories ?? [])
    .filter(
      (subcategory) => !(byCategory.get(category.id) ?? []).some((recipe) => recipe.data.subcategory === subcategory.id)
    )
    .map((subcategory) => ({
      id: `${category.id}-${subcategory.id}`,
      title: subcategory.title,
      note: `Untergruppe von ${category.title}`
    }))
)

const emptyEntries = [
  ...emptyCategories.map((category) => ({ id: category.id, title: category.title, note: category.description })),
  ...emptySubcategories
]

const anchorOffset = 'scroll-mt-[13rem]'
---

<BaseLayout>
  <section class='relative overflow-hidden'>
    <div
      class='pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-accent-soft/50 via-transparent to-transparent'
      aria-hidden='true'>
    </div>
    <div class='mx-auto max-w-[75rem] px-5 pt-16 pb-10 sm:px-8 sm:pt-24 sm:pb-12'>
      <p class='text-[0.7rem] font-bold tracking-[0.24em] text-accent uppercase'>Seit Jahren bewährt</p>
      <h1 class='mt-5 max-w-5xl font-display text-hero font-semibold text-balance'>
        Kochbuch der <span class='text-accent-display italic'>Delikatessen</span>
      </h1>
      {vorwort?.data.tagline && <p class='mt-6 max-w-2xl text-lg text-ink-soft sm:text-xl'>{vorwort.data.tagline}</p>}
    </div>
  </section>

  <RecipeExplorer total={recipes.length}>
    <div class='flex flex-col gap-16 pb-10'>
      {
        filledCategories.map((category) => {
          const categoryRecipes = byCategory.get(category.id) ?? []

          return (
            <section id={category.id} data-category-section class={anchorOffset}>
              <header class='flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-rule pb-4'>
                <div>
                  <h2 class='font-display text-section font-semibold'>{category.title}</h2>
                  {category.description && <p class='mt-1.5 text-sm text-ink-soft'>{category.description}</p>}
                </div>
                <p class='text-xs font-semibold tracking-[0.14em] text-ink-soft/80 uppercase tabular-nums'>
                  {categoryRecipes.length === 1 ? '1 Rezept' : `${categoryRecipes.length} Rezepte`}
                </p>
              </header>

              {category.subcategories ? (
                <div class='mt-8 flex flex-col gap-10'>
                  {category.subcategories.map((subcategory) => {
                    const subRecipes = categoryRecipes.filter((recipe) => recipe.data.subcategory === subcategory.id)
                    if (subRecipes.length === 0) return null
                    return (
                      <div>
                        <h3 class='mb-4 text-[0.7rem] font-bold tracking-[0.18em] text-ink-soft uppercase'>
                          {subcategory.title}
                        </h3>
                        <ul class='grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
                          {subRecipes.map((entry) => (
                            <li>
                              <RecipeCard entry={entry} />
                            </li>
                          ))}
                        </ul>
                      </div>
                    )
                  })}
                </div>
              ) : (
                <ul class='mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
                  {categoryRecipes.map((entry) => (
                    <li>
                      <RecipeCard entry={entry} />
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        })
      }

      {
        emptyEntries.length > 0 && (
          <section id='noch-leer' data-empty-block class={anchorOffset}>
            <header class='flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-rule pb-4'>
              <div>
                <h2 class='font-display text-section font-semibold'>Noch leer</h2>
                <p class='mt-1.5 text-sm text-ink-soft'>Kategorien, die auf ihr erstes Rezept warten.</p>
              </div>
            </header>
            <ul class='mt-6 flex flex-wrap gap-3'>
              {emptyEntries.map((entry) => (
                <li
                  id={entry.id}
                  data-empty-category={entry.id}
                  class='min-w-56 flex-1 rounded-2xl border border-dashed border-rule px-5 py-4 sm:flex-none'>
                  <p class='font-display text-lg font-semibold'>{entry.title}</p>
                  {entry.note && <p class='mt-1 text-sm text-ink-soft'>{entry.note}</p>}
                  <p class='mt-2 text-xs font-semibold tracking-[0.14em] text-ink-soft/80 uppercase tabular-nums'>
                    0 Rezepte
                  </p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div id='keine-treffer' class='rounded-2xl border border-dashed border-rule px-6 py-12 text-center' hidden>
        <p class='font-display text-xl font-semibold'>Für diese Auswahl gibt es noch kein Rezept.</p>
        <button
          type='button'
          data-reset-filters
          class='focus-ring mt-4 cursor-pointer rounded-full border border-rule px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-ink'>
          Filter zurücksetzen
        </button>
      </div>
    </div>
  </RecipeExplorer>

  <section id='ueber' class='mt-24 border-t border-rule/80 print:hidden'>
    <div
      class='mx-auto grid max-w-[75rem] gap-10 px-5 py-14 sm:px-8 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] md:gap-16'>
      <div>
        <h2 class='font-display text-section font-semibold'>Über dieses Kochbuch</h2>
        <div class='prose prose-lg mt-5 max-w-[42rem]'>
          <Vorwort />
        </div>
      </div>
      <dl class='self-start border-t border-rule pt-5 text-sm'>
        <div class='flex items-baseline justify-between gap-4 py-2'>
          <dt class='text-ink-soft'>Rezepte</dt>
          <dd class='font-display text-2xl font-semibold tabular-nums'>{recipes.length}</dd>
        </div>
        <div class='flex items-baseline justify-between gap-4 border-t border-rule/60 py-2'>
          <dt class='text-ink-soft'>Kategorien</dt>
          <dd class='font-display text-2xl font-semibold tabular-nums'>{filledCategories.length}</dd>
        </div>
        <p class='border-t border-rule/60 pt-4 text-ink-soft'>
          Jedes Rezept ist eine Markdown-Datei in <code class='font-mono text-[0.8rem] text-ink'>recipes/</code>.
          Website und README entstehen daraus automatisch.
        </p>
      </dl>
    </div>
  </section>
</BaseLayout>
