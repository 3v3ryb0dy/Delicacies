---
import { getImage, Image } from 'astro:assets'
import { ArrowLeft, Heart, Lightbulb, TestTubeDiagonal, UtensilsCrossed } from '@lucide/astro'
import { getCollection } from 'astro:content'
import RecipeCard from '../../components/RecipeCard.astro'
import FavoriteHandwrittenNote from '../../components/FavoriteHandwrittenNote.astro'
import { favoriteTokens } from '../../lib/favorite-note'
import RecipePreparation from '../../components/RecipePreparation.astro'
import TagChip from '../../components/TagChip.astro'
import CategoryIcon from '../../components/CategoryIcon.astro'
import LogoWatermark from '../../components/LogoWatermark.astro'
import { categoryById } from '../../config/taxonomy'
import { brandRecommendations } from '../../config/brands'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { parseIngredientBrands } from '../../lib/ingredient-brands'
import { parsePairingLinks, parseRecipeBody } from '../../lib/recipe-body'
import { withBase } from '../../lib/url'
import { resolveRecipePhoto } from '../../lib/recipe-photo'

export async function getStaticPaths() {
  const recipes = await getCollection('recipes')
  return recipes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { title, tags, imageAlt, wip, preparationPending, servings, note, source, isFavorite, favoriteText } = entry.data
const image = resolveRecipePhoto(entry.data.image)

const categoryMeta = categoryById.get(entry.data.category)
const categoryTitle = categoryMeta?.title ?? entry.data.category
const categoryShort = categoryMeta?.short ?? entry.data.category

const body = parseRecipeBody(entry.body ?? '')
// Short introductions need less space beside the photo; longer content can grow naturally.
const compactHero = title.length <= 40 && !note && !source && body.tips.length === 0
const favoriteQuote = favoriteTokens(favoriteText)
  .flatMap((token) => (token.kind === 'text' ? [token.text] : []))
  .join(' ')
const recipes = await getCollection('recipes')
const recipeIds = new Set(recipes.map((recipe) => recipe.id))
const pairings = body.pairings.map((line) => parsePairingLinks(line, recipeIds, entry.id))

/** Component sub-headings are numbered when a recipe has more than one part,
    in both columns, so ingredients and steps line up. */
const groupLabel = (index: number, title: string, numbered: boolean) =>
  numbered ? `${String(index + 1).padStart(2, '0')} · ${title}` : title

const siblings = recipes
  .filter((other) => other.data.category === entry.data.category && other.id !== entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'))
  .slice(0, 3)

const alt = imageAlt?.trim() || title
const description = imageAlt?.trim() || `${title}: Zutaten und Zubereitung aus dem Kochbuch der Delikatessen.`
const socialImage = image
  ? await getImage({
      src: image,
      width: typeof image === 'string' ? 1200 : Math.min(image.width, 1200),
      format: 'jpeg',
      quality: 72
    })
  : undefined
const previewImage = socialImage
  ? {
      src: socialImage.src,
      width: Number(socialImage.attributes.width),
      height: Number(socialImage.attributes.height),
      alt,
      type: 'image/jpeg'
    }
  : undefined
---

<BaseLayout title={title} description={description} previewTitle={title} previewImage={previewImage}>
  <article
    data-pagefind-body
    data-pagefind-meta={`category:${categoryShort}`}
    data-pagefind-filter={`wip:${wip}`}
    class='relative isolate mx-auto max-w-[75rem] px-5 pb-16 sm:px-8 print:max-w-none print:px-0 print:py-0'>
    <LogoWatermark tone='page' side='left' class='top-[3rem] left-[-124px] size-[min(46vw,22rem)]' />
    <div class='relative isolate pt-8 print:pt-0'>
      <nav class='print:hidden' aria-label='Brotkrümel'>
        <a
          href={withBase(`#rezept-${entry.id}`)}
          data-recipe-back
          data-pagefind-filter={`category:${entry.data.category}`}
          class='focus-ring inline-flex items-center gap-2 rounded-full text-sm font-semibold text-ink-soft transition-colors hover:text-ink'>
          <ArrowLeft size={16} class='shrink-0' aria-hidden='true' focusable='false' />
          Zurück zur Übersicht
        </a>
      </nav>

      <header
        class:list={[
          'recipe-hero mt-6 grid items-start gap-8 print:mt-2',
          image && 'recipe-hero--with-image print:grid-cols-[minmax(0,1fr)_minmax(0,12rem)] print:gap-8',
          image && compactHero && 'recipe-hero--compact'
        ]}>
        <div class='recipe-hero-copy min-w-0'>
          {isFavorite && (
            <p data-pagefind-ignore class='sr-only print:not-sr-only print:mb-2 print:text-xs print:font-semibold'>
              Ronnys Favorit<span class='print:hidden'>: {favoriteQuote}</span>
            </p>
          )}
          <h1 class='max-w-4xl font-display text-display font-semibold text-balance'>{title}</h1>

          {isFavorite && !image && (
            <p
              data-pagefind-ignore
              aria-hidden='true'
              class='mt-3 flex items-center gap-2 text-sm text-ink-soft print:hidden'>
              <Heart size={16} class='shrink-0 text-accent' />
              <span class='font-display italic'>{favoriteQuote}</span>
            </p>
          )}

          <div class='mt-6 flex flex-wrap items-center gap-2 print:hidden'>
            <TagChip label={categoryTitle} href={withBase(`#${entry.data.category}`)} tone='herb'>
              <CategoryIcon slot='icon' category={entry.data.category} />
            </TagChip>
            {isFavorite && (
              <span
                title='Ronnys Favorit'
                data-pagefind-ignore
                aria-hidden='true'
                class='inline-flex size-7 items-center justify-center rounded-full border border-accent/20 bg-accent-pale text-accent'>
                <Heart size={16} aria-hidden='true' focusable='false' />
              </span>
            )}
            {preparationPending && (
              <span class='rounded-full border border-accent/20 bg-accent-pale px-2.5 py-1 text-[0.65rem] font-bold tracking-[0.12em] text-accent uppercase'>
                In Arbeit
              </span>
            )}
            {wip && (
              <span
                title='Ungetestet'
                class='inline-flex size-7 items-center justify-center rounded-full border border-accent/20 bg-accent-pale text-accent'>
                <TestTubeDiagonal size={16} aria-hidden='true' focusable='false' />
                <span class='sr-only'>Ungetestet</span>
              </span>
            )}
            {tags.map((tag) => (
              <TagChip label={tag} href={withBase(`#${entry.data.category}`)} data-pagefind-filter={`tag:${tag}`} />
            ))}
            {servings && <span class='text-xs font-semibold text-ink-soft'>für {servings}</span>}
          </div>

          {(note || source) && (
            <p class='mt-4 text-sm text-ink-soft print:mt-2'>
              {note}
              {source && (
                <>
                  {' '}
                  <a href={source} class='text-accent underline decoration-dotted underline-offset-4' rel='noreferrer'>
                    Quelle
                  </a>
                </>
              )}
            </p>
          )}
          {body.tips.length > 0 && (
            <aside
              aria-labelledby='rezept-tipp'
              class='mt-5 break-inside-avoid rounded-xl border-1 border-accent/20 bg-accent-pale/20 px-4 py-3 backdrop-blur-xs print:mt-3 print:rounded-md print:border print:border-1 print:border-rule print:bg-accent-pale print:px-3 print:py-2 print:backdrop-blur-none'>
              <h2
                id='rezept-tipp'
                class='flex items-center gap-2 text-[0.7rem] font-bold tracking-[0.16em] text-accent uppercase'>
                <Lightbulb size={16} class='shrink-0' aria-hidden='true' focusable='false' />
                Tipp
              </h2>
              <p class='mt-2 text-sm leading-relaxed text-ink'>
                {body.tips
                  .join('\n')
                  .split('\n')
                  .map((line, index) => (
                    <>
                      {index > 0 && <br />}
                      {line}
                    </>
                  ))}
              </p>
            </aside>
          )}
        </div>

        {image && (
          <div class='recipe-hero-photo print:overflow-hidden print:rounded-md'>
            <div class='recipe-hero-photo-image'>
              <Image
                src={image}
                alt={alt}
                width={1440}
                height={1080}
                widths={[480, 720, 960, 1440, 1920]}
                quality={80}
                sizes='(min-width: 1200px) calc(50vw + 150px), (min-width: 960px) 65vw, (min-width: 600px) calc(100vw - 64px), calc(100vw - 40px)'
                loading='eager'
                decoding='async'
                class='aspect-4/3 w-full object-cover'
              />
            </div>
            {isFavorite && <FavoriteHandwrittenNote variant='detail' recipeId={entry.id} text={favoriteText} />}
          </div>
        )}
      </header>
    </div>

    <div class='mt-10 grid gap-12 lg:grid-cols-[minmax(0,21rem)_minmax(0,1fr)] lg:gap-16 print:mt-5 print:grid-cols-1 print:gap-6'>
      <section class='lg:sticky lg:top-28 lg:self-start print:static' aria-labelledby='zutaten'>
        <h2 id='zutaten' class='font-display text-section font-semibold print:break-after-avoid'>
          Zutaten
        </h2>
        <div
          class:list={[
            'mt-5 grid grid-cols-1 gap-7 print:mt-3 print:gap-x-10 print:gap-y-5',
            body.ingredients.length > 1 && 'print:grid-cols-2'
          ]}>
          {body.ingredients.map((group, index) => (
            <div class='break-inside-avoid'>
              {group.title && (
                <h3 class='mb-2.5 text-xs font-bold tracking-[0.14em] text-ink-soft uppercase print:mb-1.5 print:break-after-avoid'>
                  {groupLabel(index, group.title, body.ingredients.length > 1)}
                </h3>
              )}
              <ul
                class:list={[
                  'border-t border-rule/70 tabular-nums',
                  body.ingredients.length === 1 && 'print:columns-2 print:gap-10 print:border-t-0'
                ]}>
                {group.items.map((item) => (
                  <li class='break-inside-avoid border-b border-rule/50 py-2.5 text-base leading-snug text-ink print:py-1 print:text-[0.9rem]'>
                    {parseIngredientBrands(item, brandRecommendations).map((segment) =>
                      segment.brandId ? (
                        <a
                          href={withBase(`marken/#${segment.brandId}`)}
                          class='focus-ring rounded-full text-accent underline decoration-dotted underline-offset-4 hover:text-ink'
                          set:text={segment.text}
                        />
                      ) : (
                        segment.text
                      )
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
          {body.ingredients.length === 0 && (
            <p class='rounded-2xl border border-dashed border-rule px-5 py-6 text-sm text-ink-soft'>
              Zutaten werden noch ergänzt.
            </p>
          )}
        </div>
      </section>

      <section aria-labelledby='zubereitung'>
        <RecipePreparation
          normal={body.preparation}
          thermomix={body.thermomixPreparation}
          preparationPending={preparationPending}
        />

        {pairings.length > 0 && (
          <div class='mt-10 break-inside-avoid rounded-xl border-1 border-herb/20 bg-herb-soft/70 px-4 py-3 print:mt-6 print:rounded-md print:border print:border-1 print:px-3 print:py-2'>
            <h3 class='flex items-center gap-2 text-[0.7rem] font-bold tracking-[0.16em] text-herb uppercase'>
              <UtensilsCrossed size={16} class='shrink-0' aria-hidden='true' focusable='false' />
              Passt dazu
            </h3>
            <ul class='mt-2 flex flex-col gap-2 text-sm leading-relaxed text-ink'>
              {pairings.map((pairing) => (
                <li>
                  {pairing.map((segment) =>
                    segment.recipeId ? (
                      <a
                        href={withBase(`rezept/${segment.recipeId}/`)}
                        class='focus-ring rounded-full text-accent underline decoration-dotted underline-offset-4 hover:text-ink'
                        set:text={segment.text}
                      />
                    ) : (
                      segment.text
                    )
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        {body.notes.length > 0 && (
          <div class='mt-10 break-inside-avoid border-t border-rule/80 pt-5 print:mt-6 print:pt-4'>
            <h3 class='text-[0.7rem] font-bold tracking-[0.18em] text-ink-soft uppercase'>Notizen</h3>
            <ul class='mt-2.5 flex flex-col gap-1.5 text-sm text-ink-soft'>
              {body.notes.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        )}
      </section>
    </div>

    {siblings.length > 0 && (
      <section
        data-pagefind-ignore='all'
        class='mt-20 border-t border-rule/80 pt-10 print:hidden'
        aria-labelledby='mehr'>
        <h2 id='mehr' class='font-display text-section font-semibold'>
          Mehr aus dieser Kategorie
        </h2>
        <ul class='mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
          {siblings.map((sibling) => (
            <li>
              <RecipeCard entry={sibling} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <script>
    import '../../scripts/recipe-back'

    const printButton = document.getElementById('rezept-drucken')
    printButton?.addEventListener('click', () => window.print())
  </script>
</BaseLayout>

<style>
  /* Masks blend into either theme without tinting the food itself. */
  @media screen {
    .recipe-hero-photo {
      position: relative;
      overflow: hidden;
      border-radius: 0.75rem;
    }

    .recipe-hero-photo-image {
      height: 100%;
    }

    .recipe-hero-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media screen and (min-width: 960px) {
    .recipe-hero--with-image {
      min-height: 30rem;
      align-items: center;
      padding-block: 2rem 3rem;
    }

    .recipe-hero--compact {
      min-height: 23rem;
    }

    .recipe-hero--with-image .recipe-hero-copy {
      width: 62%;
    }

    .recipe-hero-photo {
      position: absolute;
      z-index: -1;
      top: 0;
      bottom: 0;
      left: 37%;
      right: min(-2rem, calc((75rem - 100vw) / 2 - 2rem));
      margin: 0;
      border-radius: 0;
      pointer-events: none;
    }

    .recipe-hero-photo-image {
      mask-image:
        radial-gradient(
          ellipse 60% 120% at 60% 10%,
          black 70%,
          rgb(0 0 0 / 65%) 78%,
          rgb(0 0 0 / 42%) 83%,
          rgb(0 0 0 / 22%) 89%,
          rgb(0 0 0 / 4%) 97%,
          transparent 100%
        ),
        linear-gradient(to bottom, black 78%, rgb(0 0 0 / 22%) 91%, rgb(0 0 0 / 4%) 97%, transparent);
      mask-composite: intersect;
    }

    .recipe-hero-photo img {
      object-position: center;
    }
  }
</style>
