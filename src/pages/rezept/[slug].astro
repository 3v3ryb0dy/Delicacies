---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import RecipeCard from '../../components/RecipeCard.astro'
import TagChip from '../../components/TagChip.astro'
import { categoryById } from '../../config/taxonomy'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { parseRecipeBody } from '../../lib/recipe-body'
import { withBase } from '../../lib/url'

export async function getStaticPaths() {
  const recipes = await getCollection('recipes')
  return recipes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { title, subcategory, tags, image, imageAlt, wip, servings, note, source } = entry.data

const categoryMeta = categoryById.get(entry.data.category)
const categoryTitle = categoryMeta?.title ?? entry.data.category
const categoryShort = categoryMeta?.short ?? entry.data.category
const subcategoryTitle = categoryMeta?.subcategories?.find((item) => item.id === subcategory)?.title

const body = parseRecipeBody(entry.body ?? '')

const siblings = (await getCollection('recipes'))
  .filter((other) => other.data.category === entry.data.category && other.id !== entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'))
  .slice(0, 3)

const alt = imageAlt ?? title
const description = `${title} — Zutaten und Zubereitung aus dem Kochbuch der Delikatessen.`
---

<BaseLayout title={title} description={description}>
  <article data-pagefind-body class='mx-auto max-w-6xl px-5 pt-8 pb-16 sm:px-8'>
    <nav class='print:hidden' aria-label='Brotkrümel'>
      <a
        href={withBase(`#${entry.data.category}`)}
        class='inline-flex items-center gap-2 text-sm font-semibold text-ink-soft transition-colors hover:text-ink'>
        <span aria-hidden='true'>←</span>
        {categoryTitle}
      </a>
    </nav>

    <header class='mt-7'>
      <div class='flex flex-wrap items-center gap-2 text-[0.7rem] font-bold tracking-[0.16em] uppercase'>
        <a
          href={withBase(`#${entry.data.category}`)}
          class='text-accent transition-colors hover:text-ink'
          data-pagefind-filter={`category:${entry.data.category}`}>
          <span data-pagefind-ignore>{categoryShort}</span>
        </a>
        {subcategoryTitle && <span class='text-ink-soft/70'>· {subcategoryTitle}</span>}
        {
          wip && (
            <span class='rounded-full border border-gold/40 px-2.5 py-1 text-[0.65rem] font-bold tracking-[0.12em] text-gold'>
              in Arbeit
            </span>
          )
        }
      </div>

      <h1 class='mt-4 max-w-3xl font-display text-display font-semibold text-balance'>{title}</h1>

      <div class='mt-5 flex flex-wrap items-center gap-2'>
        <TagChip label={categoryTitle} href={withBase(`#${entry.data.category}`)} tone='herb' />
        {
          tags.map((tag) => (
            <a href={withBase(`#${entry.data.category}`)} data-pagefind-filter={`tag:${tag}`} class='contents'>
              <TagChip label={tag} href={withBase(`#${entry.data.category}`)} />
            </a>
          ))
        }
        {servings && <span class='text-xs font-semibold text-ink-soft'>für {servings}</span>}
      </div>

      {
        (note || source) && (
          <p class='mt-4 text-sm text-ink-soft'>
            {note}
            {source && (
              <>
                {' '}
                <a href={source} class='text-accent underline decoration-dotted underline-offset-4' rel='noreferrer'>
                  Quelle
                </a>
              </>
            )}
          </p>
        )
      }
    </header>

    {
      image && (
        <div class='mt-9 overflow-hidden rounded-3xl'>
          <Image
            src={image}
            alt={alt}
            widths={[600, 1200, 1800]}
            sizes='(min-width: 1280px) 72rem, 100vw'
            loading='eager'
            decoding='async'
            class='aspect-16/9 w-full object-cover'
          />
        </div>
      )
    }

    <div class='mt-12 grid gap-12 lg:grid-cols-[minmax(0,23rem)_minmax(0,1fr)] lg:gap-16'>
      <section class='lg:sticky lg:top-28 lg:self-start' aria-labelledby='zutaten'>
        <h2 id='zutaten' class='font-display text-2xl font-semibold tracking-tight'>Zutaten</h2>
        <div class='mt-5 flex flex-col gap-7'>
          {
            body.ingredients.map((group) => (
              <div>
                {group.title && (
                  <h3 class='mb-2.5 text-[0.7rem] font-bold tracking-[0.18em] text-ink-soft uppercase'>
                    {group.title}
                  </h3>
                )}
                <ul class='border-t border-rule/70'>
                  {group.items.map((item) => (
                    <li class='border-b border-rule/50 py-2.5 text-[0.95rem] leading-snug text-ink'>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
          {
            body.ingredients.length === 0 && (
              <p class='rounded-2xl border border-dashed border-rule px-5 py-6 text-sm text-ink-soft'>
                Zutaten werden noch ergänzt.
              </p>
            )
          }
        </div>
      </section>

      <section aria-labelledby='zubereitung'>
        <div class='flex items-baseline justify-between gap-4'>
          <h2 id='zubereitung' class='font-display text-2xl font-semibold tracking-tight'>Zubereitung</h2>
          <button
            type='button'
            id='rezept-drucken'
            class='cursor-pointer rounded-full border border-rule px-4 py-1.5 text-xs font-semibold text-ink-soft transition-colors hover:border-ink hover:text-ink print:hidden'>
            Drucken
          </button>
        </div>

        <div class='mt-5 flex flex-col gap-8'>
          {
            body.preparation.map((group) => (
              <div>
                {group.title && (
                  <h3 class='mb-3 text-[0.7rem] font-bold tracking-[0.18em] text-ink-soft uppercase'>{group.title}</h3>
                )}
                <div class='flex flex-col gap-5'>
                  {group.paragraphs.map((paragraph) => (
                    <p class='text-[1.05rem] leading-8 text-ink'>{paragraph}</p>
                  ))}
                </div>
              </div>
            ))
          }
          {
            body.preparation.length === 0 && (
              <p class='rounded-2xl border border-dashed border-rule px-6 py-8 text-sm text-ink-soft'>
                Dieses Rezept ist noch in Arbeit — die Zubereitung wird nach dem ersten Kochen ergänzt.
              </p>
            )
          }
        </div>

        {
          body.pairings.length > 0 && (
            <div class='mt-10 rounded-2xl bg-herb-soft/70 px-6 py-5'>
              <h3 class='text-[0.7rem] font-bold tracking-[0.18em] text-herb uppercase'>Passt dazu</h3>
              <ul class='mt-2.5 flex flex-col gap-1.5 text-sm text-ink'>
                {body.pairings.map((pairing) => (
                  <li>{pairing}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          body.notes.length > 0 && (
            <div class='mt-10 border-t border-rule/80 pt-5'>
              <h3 class='text-[0.7rem] font-bold tracking-[0.18em] text-ink-soft uppercase'>Notizen</h3>
              <ul class='mt-2.5 flex flex-col gap-1.5 text-sm text-ink-soft'>
                {body.notes.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          )
        }
      </section>
    </div>

    {
      siblings.length > 0 && (
        <section class='mt-20 border-t border-rule/80 pt-10 print:hidden' aria-labelledby='mehr'>
          <h2 id='mehr' class='font-display text-2xl font-semibold tracking-tight'>
            Mehr aus dieser Kategorie
          </h2>
          <ul class='mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
            {siblings.map((sibling) => (
              <li>
                <RecipeCard entry={sibling} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <script>
    const printButton = document.getElementById('rezept-drucken')
    printButton?.addEventListener('click', () => window.print())
  </script>
</BaseLayout>
