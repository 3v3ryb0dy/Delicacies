---
import { getImage, Image } from 'astro:assets'
import { ArrowLeft, Lightbulb, UtensilsCrossed } from '@lucide/astro'
import { getCollection } from 'astro:content'
import RecipeCard from '../../components/RecipeCard.astro'
import RecipePreparation from '../../components/RecipePreparation.astro'
import TagChip from '../../components/TagChip.astro'
import LogoWatermark from '../../components/LogoWatermark.astro'
import { categoryById } from '../../config/taxonomy'
import { brandRecommendations } from '../../config/brands'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { parseIngredientBrands } from '../../lib/ingredient-brands'
import { parsePairingLinks, parseRecipeBody } from '../../lib/recipe-body'
import { withBase } from '../../lib/url'

export async function getStaticPaths() {
  const recipes = await getCollection('recipes')
  return recipes.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { title, subcategory, tags, image, imageAlt, wip, servings, note, source } = entry.data

const categoryMeta = categoryById.get(entry.data.category)
const categoryTitle = categoryMeta?.title ?? entry.data.category
const categoryShort = categoryMeta?.short ?? entry.data.category
const subcategoryTitle = categoryMeta?.subcategories?.find((item) => item.id === subcategory)?.title

const body = parseRecipeBody(entry.body ?? '')
const recipes = await getCollection('recipes')
const recipeIds = new Set(recipes.map((recipe) => recipe.id))
const pairings = body.pairings.map((line) => parsePairingLinks(line, recipeIds, entry.id))

/** Component sub-headings are numbered when a recipe has more than one part,
    in both columns, so ingredients and steps line up. */
const groupLabel = (index: number, title: string, numbered: boolean) =>
  numbered ? `${String(index + 1).padStart(2, '0')} · ${title}` : title

const siblings = recipes
  .filter((other) => other.data.category === entry.data.category && other.id !== entry.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'de'))
  .slice(0, 3)

const alt = imageAlt?.trim() || title
const description = imageAlt?.trim() || `${title}: Zutaten und Zubereitung aus dem Kochbuch der Delikatessen.`
const socialImage = image
  ? await getImage({ src: image, width: Math.min(image.width, 1200), format: 'jpeg', quality: 80 })
  : undefined
const previewImage = socialImage
  ? {
      src: socialImage.src,
      width: Number(socialImage.attributes.width),
      height: Number(socialImage.attributes.height),
      alt,
      type: 'image/jpeg'
    }
  : undefined
---

<BaseLayout title={title} description={description} previewTitle={title} previewImage={previewImage}>
  <article
    data-pagefind-body
    data-pagefind-filter={`wip:${wip}`}
    class='relative isolate mx-auto max-w-[75rem] px-5 pt-8 pb-16 sm:px-8 print:max-w-none print:px-0 print:py-0'>
    <LogoWatermark tone='page' side='left' class='top-[3rem] left-[-124px] size-[min(46vw,22rem)]' />
    <nav class='print:hidden' aria-label='Brotkrümel'>
      <a
        href={withBase(`#${entry.data.category}`)}
        class='focus-ring inline-flex items-center gap-2 rounded-full text-sm font-semibold text-ink-soft transition-colors hover:text-ink'>
        <ArrowLeft size={16} class='shrink-0' aria-hidden='true' focusable='false' />
        {categoryTitle}
      </a>
    </nav>

    <header
      class:list={[
        'mt-7 grid items-start gap-8 print:mt-2',
        image &&
          'md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] print:grid-cols-[minmax(0,1fr)_minmax(0,12rem)] print:gap-8'
      ]}>
      <div class='min-w-0'>
        <div class='flex flex-wrap items-center gap-2 text-[0.7rem] font-bold tracking-[0.16em] uppercase'>
          <a
            href={withBase(`#${entry.data.category}`)}
            class='focus-ring rounded-full text-accent transition-colors hover:text-ink'
            data-pagefind-filter={`category:${entry.data.category}`}>
            <span data-pagefind-ignore>{categoryShort}</span>
          </a>
          {subcategoryTitle && <span class='text-ink-soft/70'>· {subcategoryTitle}</span>}
          {wip && (
            <span class='rounded-full border border-accent/20 bg-accent-pale px-2.5 py-1 text-[0.65rem] font-bold tracking-[0.12em] text-accent'>
              in Arbeit
            </span>
          )}
        </div>

        <h1 class='mt-5 max-w-4xl font-display text-display font-semibold text-balance print:mt-2'>{title}</h1>

        <div class='mt-6 flex flex-wrap items-center gap-2 print:hidden'>
          <TagChip label={categoryTitle} href={withBase(`#${entry.data.category}`)} tone='herb' />
          {tags.map((tag) => (
            <a href={withBase(`#${entry.data.category}`)} data-pagefind-filter={`tag:${tag}`} class='contents'>
              <TagChip label={tag} href={withBase(`#${entry.data.category}`)} />
            </a>
          ))}
          {servings && <span class='text-xs font-semibold text-ink-soft'>für {servings}</span>}
        </div>

        {(note || source) && (
          <p class='mt-4 text-sm text-ink-soft print:mt-2'>
            {note}
            {source && (
              <>
                {' '}
                <a href={source} class='text-accent underline decoration-dotted underline-offset-4' rel='noreferrer'>
                  Quelle
                </a>
              </>
            )}
          </p>
        )}
        {body.tips.length > 0 && (
          <aside
            aria-labelledby='rezept-tipp'
            class='mt-5 break-inside-avoid rounded-xl border-1 border-accent/20 bg-accent-pale px-4 py-3 print:mt-3 print:rounded-md print:border print:border-1 print:px-3 print:py-2'>
            <h2
              id='rezept-tipp'
              class='flex items-center gap-2 text-[0.7rem] font-bold tracking-[0.16em] text-accent uppercase'>
              <Lightbulb size={16} class='shrink-0' aria-hidden='true' focusable='false' />
              Tipp
            </h2>
            <p class='mt-2 text-sm leading-relaxed text-ink'>
              {body.tips
                .join('\n')
                .split('\n')
                .map((line, index) => (
                  <>
                    {index > 0 && <br />}
                    {line}
                  </>
                ))}
            </p>
          </aside>
        )}
      </div>

      {image && (
        <div class='mx-auto w-full max-w-80 overflow-hidden rounded-xl md:max-w-none print:mx-0 print:rounded-md'>
          <Image
            src={image}
            alt={alt}
            widths={[320, 400, 640, 800]}
            sizes='(min-width: 1200px) 368px, (min-width: 960px) calc((100vw - 96px) / 3), (min-width: 360px) 320px, calc(100vw - 40px)'
            loading='eager'
            decoding='async'
            class='aspect-4/3 w-full object-cover'
          />
        </div>
      )}
    </header>

    <div class='mt-10 grid gap-12 lg:grid-cols-[minmax(0,21rem)_minmax(0,1fr)] lg:gap-16 print:mt-5 print:grid-cols-1 print:gap-6'>
      <section class='lg:sticky lg:top-28 lg:self-start print:static' aria-labelledby='zutaten'>
        <h2 id='zutaten' class='font-display text-section font-semibold print:break-after-avoid'>
          Zutaten
        </h2>
        <div
          class:list={[
            'mt-5 grid grid-cols-1 gap-7 print:mt-3 print:gap-x-10 print:gap-y-5',
            body.ingredients.length > 1 && 'print:grid-cols-2'
          ]}>
          {body.ingredients.map((group, index) => (
            <div class='break-inside-avoid'>
              {group.title && (
                <h3 class='mb-2.5 text-xs font-bold tracking-[0.14em] text-ink-soft uppercase print:mb-1.5 print:break-after-avoid'>
                  {groupLabel(index, group.title, body.ingredients.length > 1)}
                </h3>
              )}
              <ul
                class:list={[
                  'border-t border-rule/70 tabular-nums',
                  body.ingredients.length === 1 && 'print:columns-2 print:gap-10 print:border-t-0'
                ]}>
                {group.items.map((item) => (
                  <li class='break-inside-avoid border-b border-rule/50 py-2.5 text-base leading-snug text-ink print:py-1 print:text-[0.9rem]'>
                    {parseIngredientBrands(item, brandRecommendations).map((segment) =>
                      segment.brandId ? (
                        <a
                          href={withBase(`marken/#${segment.brandId}`)}
                          class='focus-ring rounded-full text-accent underline decoration-dotted underline-offset-4 hover:text-ink'
                          set:text={segment.text}
                        />
                      ) : (
                        segment.text
                      )
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
          {body.ingredients.length === 0 && (
            <p class='rounded-2xl border border-dashed border-rule px-5 py-6 text-sm text-ink-soft'>
              Zutaten werden noch ergänzt.
            </p>
          )}
        </div>
      </section>

      <section aria-labelledby='zubereitung'>
        <RecipePreparation
          normal={body.preparation}
          thermomix={body.thermomixPreparation}
          preparationPending={entry.data.preparationPending}
        />

        {pairings.length > 0 && (
          <div class='mt-10 break-inside-avoid rounded-xl border-1 border-herb/20 bg-herb-soft/70 px-4 py-3 print:mt-6 print:rounded-md print:border print:border-1 print:px-3 print:py-2'>
            <h3 class='flex items-center gap-2 text-[0.7rem] font-bold tracking-[0.16em] text-herb uppercase'>
              <UtensilsCrossed size={16} class='shrink-0' aria-hidden='true' focusable='false' />
              Passt dazu
            </h3>
            <ul class='mt-2 flex flex-col gap-2 text-sm leading-relaxed text-ink'>
              {pairings.map((pairing) => (
                <li>
                  {pairing.map((segment) =>
                    segment.recipeId ? (
                      <a
                        href={withBase(`rezept/${segment.recipeId}/`)}
                        class='focus-ring rounded-full text-accent underline decoration-dotted underline-offset-4 hover:text-ink'
                        set:text={segment.text}
                      />
                    ) : (
                      segment.text
                    )
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        {body.notes.length > 0 && (
          <div class='mt-10 break-inside-avoid border-t border-rule/80 pt-5 print:mt-6 print:pt-4'>
            <h3 class='text-[0.7rem] font-bold tracking-[0.18em] text-ink-soft uppercase'>Notizen</h3>
            <ul class='mt-2.5 flex flex-col gap-1.5 text-sm text-ink-soft'>
              {body.notes.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        )}
      </section>
    </div>

    {siblings.length > 0 && (
      <section
        data-pagefind-ignore='all'
        class='mt-20 border-t border-rule/80 pt-10 print:hidden'
        aria-labelledby='mehr'>
        <h2 id='mehr' class='font-display text-section font-semibold'>
          Mehr aus dieser Kategorie
        </h2>
        <ul class='mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
          {siblings.map((sibling) => (
            <li>
              <RecipeCard entry={sibling} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <script>
    const printButton = document.getElementById('rezept-drucken')
    printButton?.addEventListener('click', () => window.print())
  </script>
</BaseLayout>
