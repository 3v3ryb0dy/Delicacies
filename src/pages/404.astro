---
import BaseLayout from '../layouts/BaseLayout.astro'
import { withBase } from '../lib/url'
---

<BaseLayout
  title='Seite nicht gefunden'
  description='Diese Adresse gibt es im Kochbuch der Delikatessen nicht.'
  noindex>
  <div data-base={withBase()} class='mx-auto max-w-3xl px-5 pt-16 pb-10 sm:px-8'>
    <p class='text-[0.7rem] font-bold tracking-[0.24em] text-accent uppercase'>Fehler 404</p>
    <h1 class='mt-5 font-display text-display font-semibold text-balance'>Diese Seite fehlt noch.</h1>
    <p class='mt-5 max-w-[42rem] text-lg leading-8 text-ink-soft'>
      Vielleicht ist der Link veraltet, oder in der Adresse steckt ein Tippfehler. Zurück zum Kochbuch?
    </p>

    <div class='mt-8 flex flex-wrap items-center gap-3'>
      <a
        href={withBase()}
        class='focus-ring rounded-full border border-transparent bg-ink px-4 py-2 text-sm font-semibold text-paper transition-colors hover:bg-accent'>
        Alle Rezepte
      </a>
      <a
        href={withBase('ideen/')}
        class='focus-ring rounded-full border border-rule px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-ink'>
        Ideen
      </a>
    </div>
  </div>

  <script>
    import { lowercasePathAfterBase } from '../lib/lowercase-path'

    const base = document.querySelector<HTMLElement>('[data-base]')?.dataset.base ?? '/'
    const corrected = lowercasePathAfterBase(window.location.pathname, base)

    if (corrected) window.location.replace(corrected + window.location.search + window.location.hash)
  </script>
</BaseLayout>
