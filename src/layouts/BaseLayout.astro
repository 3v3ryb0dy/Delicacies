---
import '@fontsource-variable/fraunces/opsz.css'
import '@fontsource-variable/nunito-sans'
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url'
import nunitoSansLatin from '@fontsource-variable/nunito-sans/files/nunito-sans-latin-wght-normal.woff2?url'
import '../tailwind.css'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { withBase } from '../lib/url'

type Props = {
  title?: string
  description?: string
  previewTitle?: string
  previewImage?: {
    src: string
    width: number
    height: number
    alt: string
    type: string
  }
}

const {
  title,
  description = 'Kochbuch der Delikatessen. Über Jahre gesammelte Rezepte, die sich bewährt haben.',
  previewTitle,
  previewImage
} = Astro.props

const pageTitle = title ? `${title} | Kochbuch der Delikatessen` : 'Kochbuch der Delikatessen'
const canonical = new URL(Astro.url.pathname, Astro.site)
const socialTitle = previewTitle ?? pageTitle
const imageUrl = previewImage ? new URL(previewImage.src, Astro.site).href : undefined
---

<!doctype html>
<html lang='de' class='bg-paper'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='generator' content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name='description' content={description} />
    <link rel='canonical' href={canonical} />
    <link rel='icon' type='image/x-icon' sizes='16x16 32x32 48x48' href={withBase('favicon.ico')} />
    <link rel='icon' type='image/svg+xml' sizes='any' href={withBase('logo.svg')} />
    <link rel='apple-touch-icon' sizes='180x180' href={withBase('apple-touch-icon.png')} />
    <meta name='theme-color' content='#fff9f3' media='(prefers-color-scheme: light)' />
    <meta name='theme-color' content='#16120f' media='(prefers-color-scheme: dark)' />
    <!-- The webfonts are bundled locally (see the @fontsource-variable imports),
         never fetched from Google. Preloading the Latin cuts pulls them in with
         the stylesheet instead of after it, so the swap into Nunito Sans and
         Fraunces happens before the first paint. -->
    <link rel='preload' href={nunitoSansLatin} as='font' type='font/woff2' crossorigin />
    <link rel='preload' href={frauncesLatin} as='font' type='font/woff2' crossorigin />
    <meta property='og:title' content={socialTitle} />
    <meta property='og:description' content={description} />
    <meta property='og:type' content='website' />
    <meta property='og:locale' content='de_DE' />
    <meta property='og:url' content={canonical.href} />
    <meta property='og:site_name' content='Kochbuch der Delikatessen' />
    {previewImage && (
      <>
        <meta property='og:image' content={imageUrl} />
        <meta property='og:image:type' content={previewImage.type} />
        <meta property='og:image:width' content={String(previewImage.width)} />
        <meta property='og:image:height' content={String(previewImage.height)} />
        <meta property='og:image:alt' content={previewImage.alt} />
      </>
    )}
    <meta name='twitter:card' content={previewImage ? 'summary_large_image' : 'summary'} />
    <meta name='twitter:title' content={socialTitle} />
    <meta name='twitter:description' content={description} />
    {previewImage && (
      <>
        <meta name='twitter:image' content={imageUrl} />
        <meta name='twitter:image:alt' content={previewImage.alt} />
      </>
    )}
  </head>
  <body class='flex min-h-dvh flex-col bg-paper text-ink'>
    <a
      href='#inhalt'
      class='focus-ring sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-5 focus:py-2 focus:text-sm focus:font-semibold focus:text-paper'>
      Zum Inhalt springen
    </a>
    <Header />
    <!-- `overflow-x-clip` (not `hidden`) lets the oversized watermarks bleed
         past the page edges without adding a horizontal scrollbar, while
         keeping `position: sticky` working for descendants. -->
    <main id='inhalt' class='flex-1 overflow-x-clip'>
      <slot />
    </main>
    <Footer />
  </body>
</html>
