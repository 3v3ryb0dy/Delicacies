---
import { withBase } from '../lib/url'

const navItems = [
  { href: withBase('ideen/'), label: 'Ideen' },
  { href: withBase('aromen/'), label: 'Aromen' },
  { href: withBase('marken/'), label: 'Marken' }
]
---

<header class='sticky top-0 z-30 border-b border-rule/70 bg-paper/85 backdrop-blur-md print:hidden'>
  <div class='mx-auto flex h-18 max-w-[75rem] items-center justify-between gap-2 px-5 sm:gap-4 sm:px-8'>
    <a
      href={withBase()}
      aria-label='Kochbuch der Delikatessen – Startseite'
      class='focus-ring group flex shrink-0 items-center gap-2 rounded-full sm:gap-3'>
      <img
        src={withBase('logo.svg')}
        alt=''
        width='32'
        height='32'
        class='size-8 shrink-0 transition-transform duration-200 group-hover:-rotate-6'
      />
      <span class='hidden flex-col justify-center leading-tight min-[400px]:flex'>
        <span class='font-display text-[1.05rem] font-semibold tracking-tight whitespace-nowrap text-ink'>
          <span class='sm:hidden'>Delikatessen</span>
          <span class='hidden sm:inline'>Kochbuch der Delikatessen</span>
        </span>
        <span class='hidden text-[0.7rem] tracking-[0.14em] text-ink-soft uppercase sm:block'>
          Rezepte &amp; Grundlagen
        </span>
      </span>
    </a>

    <nav aria-label='Hauptnavigation' class='flex shrink-0 items-center gap-1'>
      {navItems.map((item) => (
        <a
          href={item.href}
          class='focus-ring rounded-full px-2 py-2 text-sm font-semibold text-ink-soft transition-colors hover:bg-paper-sunken hover:text-ink sm:px-3.5'>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
