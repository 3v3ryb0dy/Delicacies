---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'svg'> & { size?: number | string }
const { size = 24, ...attributes } = Astro.props
---

<svg
  xmlns='http://www.w3.org/2000/svg'
  width={size}
  height={size}
  viewBox='0 0 24 24'
  fill='none'
  stroke='currentColor'
  stroke-width='2'
  stroke-linecap='round'
  stroke-linejoin='round'
  {...attributes}>
  <path d='M17 9h2a3 3 0 0 1 0 6h-3' />
  <path d='M3 6c3 3 7 3 14 3v2a6 6 0 0 1-12 0c0-2-1-3-2-5Z' />
  <path d='M11 17v3M7 20h8' />
</svg>
