---
import { Heart } from '@lucide/astro'
---

<div data-pagefind-ignore class='ronny-favorite'>
  <span class='favorite-bookmark' title='Ronnys Favorit'>
    <Heart size={20} aria-hidden='true' focusable='false' />
    <span class='sr-only print:not-sr-only'>Ronnys Favorit</span>
    <svg
      class='favorite-bookmark-outline'
      viewBox='0 0 36 48'
      preserveAspectRatio='none'
      aria-hidden='true'
      focusable='false'>
      <path
        d='M .5 0 V 47.25 L 18 40.5 L 35.5 47.25 V 0'
        fill='none'
        stroke='currentColor'
        stroke-opacity='.35'
        stroke-width='1'
        vector-effect='non-scaling-stroke'
      />
    </svg>
  </span>
</div>

<style>
  .ronny-favorite {
    flex-shrink: 0;
    color: var(--color-ink);
  }

  .favorite-bookmark {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 3rem;
    padding-bottom: 0.4375rem;
    overflow: hidden;
    background: linear-gradient(
      145deg,
      color-mix(in srgb, var(--color-accent) 18%, var(--color-paper-raised)),
      color-mix(in srgb, var(--color-accent) 10%, var(--color-paper-raised))
    );
    color: var(--color-accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% calc(100% - 0.4375rem), 0 100%);
  }

  /* Follow the sides and notch, leaving the top open at the card edge. */
  .favorite-bookmark-outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  @media print {
    .favorite-bookmark {
      width: auto;
      height: auto;
      background: none;
      color: var(--color-ink);
      clip-path: none;
      padding: 0;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .favorite-bookmark :global(svg) {
      display: none;
    }
  }
</style>
