---
import type { AromaCombination } from '../config/aroma-combinations'
import { aromas } from '../config/aromas'
import { combinationSearchFields } from '../lib/aroma-search'
import { withBase } from '../lib/url'
type Props = { combination: AromaCombination }
const { combination } = Astro.props
const plans = [{ title: undefined, steps: combination.steps }, ...(combination.variant ? [combination.variant] : [])]
---

<article
  id={combination.id}
  data-aroma-entry='combination'
  data-search-fields={JSON.stringify(combinationSearchFields(combination, aromas))}
  class='scroll-mt-8 rounded-2xl border border-rule bg-paper-raised p-4 sm:p-5'>
  <span class='inline-block rounded-full bg-herb-soft px-3 py-1 text-xs font-bold text-herb'>{combination.status}</span>
  <h3 class='mt-4 font-display text-2xl leading-tight font-semibold text-balance'>{combination.title}</h3>
  <p class='mt-3 text-sm font-semibold text-accent'>{combination.tags.join(' · ')}</p>
  <p data-match-reason hidden class='mt-3 text-sm font-semibold text-accent'></p>
  <p class='mt-4 leading-7 text-ink-soft'>{combination.why}</p>
  {plans.map((plan) => (
    <div class='mt-6'>
      {plan.title && <h4 class='mb-4 border-t border-rule pt-5 font-display text-xl font-semibold'>{plan.title}</h4>}
      <ol class='space-y-5'>
        {plan.steps.map((step, index) => (
          <li class='border-l-2 border-accent-soft pl-4'>
            <p class='text-sm font-bold text-accent'>
              {String(index + 1).padStart(2, '0')} · {step.place}
            </p>
            <p class='mt-1 text-sm font-semibold text-ink-soft'>{step.when}</p>
            <p class='mt-2 leading-7'>{step.instruction}</p>
            {step.ingredients.length > 0 && (
              <ul class='mt-3 space-y-2 text-sm text-ink-soft'>
                {step.ingredients.map((ingredient) => (
                  <li>
                    {ingredient.aromaId ? (
                      <a
                        class='focus-ring font-bold text-accent underline underline-offset-4'
                        href={`#${ingredient.aromaId}`}>
                        {ingredient.name}
                      </a>
                    ) : (
                      <span class='font-bold'>{ingredient.name}</span>
                    )}
                    {' · '}
                    {ingredient.form}
                    <span class='block'>{ingredient.role}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </div>
  ))}
  {combination.note && <p class='mt-5 rounded-xl bg-paper-sunken p-3 leading-7'>{combination.note}</p>}
  {combination.recipePath && (
    <a
      class='focus-ring mt-5 inline-block font-bold text-accent underline underline-offset-4'
      href={withBase(combination.recipePath)}>
      Zum Rezept →
    </a>
  )}
  {combination.sources && (
    <ul class='mt-5 space-y-2 border-t border-rule pt-4 text-sm'>
      {combination.sources.map((source) => (
        <li>
          <a class='focus-ring text-accent underline underline-offset-4' href={source.url}>
            {source.title} ↗
          </a>
        </li>
      ))}
    </ul>
  )}
</article>
