---
import {
  Cake,
  CakeSlice,
  Carrot,
  Cookie,
  CookingPot,
  Croissant,
  CupSoda,
  IceCreamBowl,
  Salad,
  Sandwich,
  Soup,
  Utensils
} from '@lucide/astro'
import type { CategoryId } from '../config/taxonomy'
import SauceBoatIcon from './SauceBoatIcon.astro'

type Props = { category: CategoryId; size?: number; class?: string }
const { category, size = 16, class: className } = Astro.props
const icons = {
  vorspeisen: Sandwich,
  hauptgerichte: CookingPot,
  desserts: IceCreamBowl,
  beilagen: Carrot,
  kuchen: CakeSlice,
  torten: Cake,
  gebaeck: Cookie,
  brot: Croissant,
  saucen: SauceBoatIcon,
  salate: Salad,
  suppen: Soup,
  getraenke: CupSoda,
  sonstiges: Utensils
} satisfies Record<CategoryId, typeof Utensils>
const Icon = icons[category]
---

<Icon size={size} class:list={['shrink-0', className]} aria-hidden='true' focusable='false' />
