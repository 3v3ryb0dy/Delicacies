---
import { Search } from '@lucide/astro'
import { categories, tagVocabulary } from '../config/taxonomy'
import { withBase } from '../lib/url'
import TagChip from './TagChip.astro'

type Props = {
  total: number
}

const { total } = Astro.props

const scrollRowClass =
  'no-scrollbar -mx-1 flex flex-nowrap items-center gap-2 overflow-x-auto px-1 pb-0.5 lg:mx-0 lg:flex-wrap lg:overflow-visible lg:px-0'
const chipClass =
  'focus-ring cursor-pointer rounded-full border border-rule bg-paper-raised px-3.5 py-1.5 text-xs font-semibold tracking-wide text-ink-soft transition-colors hover:text-ink'
---

<section id='rezepte' class='mx-auto max-w-[75rem] scroll-mt-24 px-5 sm:px-8'>
  <div
    data-sticky-bar
    class='sticky top-18 z-20 -mx-5 border-b border-rule/80 bg-paper/85 px-5 py-3 backdrop-blur-md sm:-mx-8 sm:px-8'>
    <div class='flex flex-col gap-3'>
      <div class='flex flex-wrap items-center gap-3'>
        <label class='relative flex-1 sm:max-w-md'>
          <span class='sr-only'>Rezepte durchsuchen</span>
          <Search
            size={16}
            class='pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-ink-soft'
            aria-hidden='true'
            focusable='false'
          />
          <input
            id='rezept-suche'
            type='search'
            autocomplete='off'
            placeholder='Zutat oder Gericht suchen …'
            class='focus-ring w-full rounded-full border border-rule bg-paper-raised py-2.5 pr-4 pl-10 text-sm text-ink transition-colors placeholder:text-ink-soft/70 focus:border-accent'
          />
        </label>
        <p id='rezept-status' class='text-sm text-ink-soft tabular-nums' aria-live='polite'>
          {total} Rezepte
        </p>
        <label
          data-wip-control
          class='flex min-h-9 cursor-pointer items-center gap-2 text-xs font-semibold text-ink-soft'
          hidden>
          <input id='show-wip' type='checkbox' role='switch' class='peer sr-only' />
          <span
            aria-hidden='true'
            class='relative h-5 w-9 shrink-0 rounded-full bg-rule transition-colors peer-checked:bg-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-accent after:absolute after:top-0.5 after:left-0.5 after:size-4 after:rounded-full after:bg-paper after:transition-transform peer-checked:after:translate-x-4'></span>
          Ungetestete Rezepte anzeigen
        </label>
      </div>

      <div class={scrollRowClass}>
        <button
          type='button'
          data-filter-category=''
          class='focus-ring cursor-pointer rounded-full border border-transparent bg-ink px-3.5 py-1.5 text-xs font-semibold tracking-wide text-paper'>
          Alle
        </button>
        {categories.map((category) => (
          <button type='button' data-filter-category={category.id} class={chipClass}>
            {category.short}
          </button>
        ))}
      </div>
    </div>
  </div>

  {/* Deliberately outside the sticky area: the tag row scrolls away so the
      pinned bar stays two rows tall. */}
  <div data-tag-row class='border-b border-rule/60 pt-4 pb-3'>
    <div class={scrollRowClass}>
      <span class='shrink-0 pr-1 text-[0.7rem] font-semibold tracking-[0.14em] text-ink-soft/80 uppercase'>
        Schlagworte
      </span>
      {tagVocabulary.map((tag) => (
        <button type='button' data-filter-tag={tag} class='focus-ring cursor-pointer rounded-full'>
          <TagChip label={tag} interactive />
        </button>
      ))}
    </div>
  </div>

  <div id='suche-bereich' class='mt-8' hidden>
    <h2 class='font-display text-section font-semibold'>Suchergebnisse</h2>
    <ul id='suche-liste' class='mt-5 flex flex-col gap-2'></ul>
    <p id='suche-leer' class='mt-6 text-sm text-ink-soft' hidden>
      Keine Rezepte gefunden.
    </p>
  </div>

  <div id='rezept-liste' data-recipe-list class='mt-12'>
    <slot />
  </div>

  <script is:inline data-pagefind-url={withBase('pagefind/pagefind.js')} data-base-path={withBase()}>
    const scriptElement = document.currentScript
    const pagefindUrl = scriptElement?.dataset.pagefindUrl
    const basePath = scriptElement?.dataset.basePath ?? '/'

    const cardList = document.getElementById('rezept-liste')
    const searchArea = document.getElementById('suche-bereich')
    const searchList = document.getElementById('suche-liste')
    const searchEmpty = document.getElementById('suche-leer')
    const status = document.getElementById('rezept-status')
    const input = document.getElementById('rezept-suche')
    const sections = Array.from(document.querySelectorAll('[data-category-section]'))
    const cards = Array.from(document.querySelectorAll('[data-recipe]'))
    const categoryButtons = Array.from(document.querySelectorAll('[data-filter-category]'))
    const tagButtons = Array.from(document.querySelectorAll('[data-filter-tag]'))
    const emptyBlock = document.querySelector('[data-empty-block]')
    const emptyEntries = Array.from(document.querySelectorAll('[data-empty-category]'))
    const noResults = document.getElementById('keine-treffer')
    const resetButton = document.querySelector('[data-reset-filters]')
    const stickyBar = document.querySelector('[data-sticky-bar]')

    const wipToggle = document.getElementById('show-wip')
    const preferenceKey = 'delicacies.showWip'
    let showWip = false
    try {
      showWip = localStorage.getItem(preferenceKey) === 'true'
    } catch {
      // Browsing still works when storage is unavailable.
    }
    wipToggle.checked = showWip
    document.querySelector('[data-wip-control]').hidden = false
    const availableTotal = () => cards.filter((card) => showWip || card.dataset.wip !== 'true').length
    const emptyIds = emptyEntries.map((entry) => entry.dataset.emptyCategory)
    let activeCategory = ''
    const activeTags = new Set()
    let pagefind
    let pagefindFailed = false
    let searchToken = 0
    let debounce

    const beginResultsChange = () => {
      clearTimeout(debounce)
      ++searchToken
      if (window.location.hash) {
        history.replaceState(history.state, '', window.location.pathname + window.location.search)
      }
    }

    const resultsOffset = () => {
      const stickyTop = parseFloat(getComputedStyle(stickyBar).top) || 0
      return stickyTop + stickyBar.getBoundingClientRect().height + 16
    }

    // Native category links use the same measured clearance as filtering.
    // Scroll padding and scroll margin add together, so subtract the global padding.
    const updateAnchorOffset = () => {
      const padding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0
      document.getElementById('rezepte').style.setProperty('--recipe-anchor-margin', resultsOffset() - padding + 'px')
    }
    updateAnchorOffset()
    new ResizeObserver(updateAnchorOffset).observe(stickyBar)

    const scrollToResults = () => {
      const target = searchArea.hidden ? cardList : searchArea
      const offset = resultsOffset()
      window.scrollTo({
        top: Math.max(0, window.scrollY + target.getBoundingClientRect().top - offset),
        behavior: 'instant'
      })
    }

    const chipBase = 'focus-ring cursor-pointer rounded-full border px-3.5 py-1.5 text-xs font-semibold tracking-wide'
    const chipActive = 'border-transparent bg-ink text-paper'
    const chipIdle = 'border-rule bg-paper-raised text-ink-soft transition-colors hover:text-ink'
    const tagBase =
      'inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-semibold tracking-wide transition-colors'
    const tagActive = 'bg-ink text-paper'
    const tagIdle = 'bg-paper-sunken text-ink-soft'

    const activeFilters = () => {
      const filters = {}
      if (!showWip) filters.wip = ['false']
      if (activeCategory) filters.category = [activeCategory]
      if (activeTags.size) filters.tag = Array.from(activeTags)
      return filters
    }

    const paintButtons = () => {
      categoryButtons.forEach((button) => {
        const isActive = (button.dataset.filterCategory || '') === activeCategory
        button.className = chipBase + ' ' + (isActive ? chipActive : chipIdle)
      })
      tagButtons.forEach((button) => {
        const chip = button.querySelector('[data-chip-label]')
        if (!chip) return
        const isActive = activeTags.has(button.dataset.filterTag)
        chip.className = tagBase + ' ' + (isActive ? tagActive : tagIdle)
      })
    }

    const matches = (card) => {
      if (!showWip && card.dataset.wip === 'true') return false
      if (activeCategory && card.dataset.category !== activeCategory) return false
      if (activeTags.size) {
        const cardTags = (card.dataset.tags || '').split(/\s+/).filter(Boolean)
        if (!cardTags.some((tag) => activeTags.has(tag))) return false
      }
      return true
    }

    const applyFilters = () => {
      let visible = 0
      cards.forEach((card) => {
        const ok = matches(card)
        card.closest('[data-recipe-item]').hidden = !ok
        if (ok) visible += 1
      })
      document.querySelectorAll('[data-subcategory-section]').forEach((section) => {
        section.hidden = !section.querySelector('[data-recipe-item]:not([hidden])')
      })
      sections.forEach((section) => {
        const count = section.querySelectorAll('[data-recipe-item]:not([hidden])').length
        section.hidden = count === 0
        section.querySelector('[data-category-count]').textContent = count === 1 ? '1 Rezept' : count + ' Rezepte'
      })
      const total = availableTotal()

      const filtering = !showWip || Boolean(activeCategory) || activeTags.size > 0
      const selectedEmptyCategory = activeCategory !== '' && emptyIds.indexOf(activeCategory) !== -1

      if (emptyBlock) {
        emptyBlock.hidden = activeTags.size > 0 || (activeCategory !== '' && !selectedEmptyCategory)
        emptyEntries.forEach((entry) => {
          entry.hidden = activeCategory !== '' && entry.dataset.emptyCategory !== activeCategory
        })
      }

      if (noResults) {
        noResults.hidden = !(filtering && visible === 0 && !selectedEmptyCategory)
      }

      if (selectedEmptyCategory && visible === 0) status.textContent = 'Noch keine Rezepte'
      else if (visible === total) status.textContent = total === 1 ? '1 Rezept' : total + ' Rezepte'
      else status.textContent = visible + ' von ' + total + ' Rezepten'
    }

    const escapeHtml = (value) =>
      value.replace(
        /[&<>"']/g,
        (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]
      )

    /**
     * Pagefind only exists in a built site, so `astro dev` has no bundle to
     * import. The explorer then falls back to matching the rendered recipe
     * cards by title, tags, ingredients and preparation.
     */
    const fold = (value) => (value || '').toLowerCase()

    const fallbackCards = cards.map((card) => ({
      title: card.dataset.title || 'Rezept',
      category: card.dataset.categoryLabel || '',
      url: card.querySelector('a')?.getAttribute('href') || '#',
      detail: card.dataset.search || '',
      card: card,
      haystack: fold(
        [card.dataset.title, card.dataset.categoryLabel, card.dataset.category, card.dataset.tags, card.dataset.search]
          .filter(Boolean)
          .join(' · ')
      )
    }))

    const excerpt = (text, token) => {
      const index = fold(text).indexOf(token)
      const start = index === -1 ? 0 : Math.max(0, index - 60)
      const end = index === -1 ? 140 : Math.min(text.length, index + 90)
      return (start > 0 ? '…' : '') + text.slice(start, end).trim() + (end < text.length ? '…' : '')
    }

    // Pagefind already prefixes result URLs with the site base (it derives it
    // from where its bundle is served), so only add the base when it is absent.
    const resolveResultUrl = (url) => {
      if (/^[a-z][a-z0-9+.-]*:/i.test(url) || url.startsWith('//')) return url
      const base = basePath.replace(/\/$/, '')
      if (!base || url === base || url.startsWith(base + '/')) return url
      return base + (url.startsWith('/') ? url : '/' + url)
    }

    const showSections = () => {
      cardList.hidden = false
      searchArea.hidden = true
      applyFilters()
    }

    const appendResult = (url, title, meta, excerptHtml) => {
      const item = document.createElement('li')
      item.innerHTML =
        '<a href="' +
        escapeHtml(url) +
        '" class="focus-ring border-rule bg-paper-raised hover:border-ink/25 flex flex-col gap-1 rounded-2xl border px-5 py-4 transition-colors">' +
        '<span class="font-display text-lg font-semibold tracking-tight">' +
        escapeHtml(title) +
        '</span>' +
        (meta
          ? '<span class="text-accent text-xs font-semibold uppercase tracking-[0.12em]">' +
            escapeHtml(meta) +
            '</span>'
          : '') +
        (excerptHtml ? '<span class="text-ink-soft text-sm leading-relaxed">' + excerptHtml + '</span>' : '') +
        '</a>'
      searchList.appendChild(item)
    }

    const runLocalSearch = (query) => {
      const tokens = fold(query).split(/\s+/).filter(Boolean)
      const hits = fallbackCards
        .filter((entry) => matches(entry.card) && tokens.every((token) => entry.haystack.indexOf(token) !== -1))
        .sort((a, b) => {
          const aTitle = fold(a.title).indexOf(tokens[0]) !== -1 ? 0 : 1
          const bTitle = fold(b.title).indexOf(tokens[0]) !== -1 ? 0 : 1
          return aTitle - bTitle || a.title.localeCompare(b.title, 'de')
        })

      if (hits.length === 0) {
        searchEmpty.hidden = false
        status.textContent = 'Keine Treffer'
        return
      }

      hits.slice(0, 40).forEach((entry) => {
        appendResult(entry.url, entry.title, entry.category, escapeHtml(excerpt(entry.detail, tokens[0])))
      })

      status.textContent = hits.length === 1 ? '1 Treffer' : hits.length + ' Treffer'
    }

    const runSearch = async (query) => {
      const token = ++searchToken
      cardList.hidden = true
      searchArea.hidden = false
      searchEmpty.hidden = true
      searchList.innerHTML = ''

      if (!pagefind && !pagefindFailed) {
        try {
          pagefind = await import(pagefindUrl)
          await pagefind.init()
        } catch {
          pagefind = null
          pagefindFailed = true
        }
        if (token !== searchToken) return
      }

      if (!pagefind) {
        runLocalSearch(query)
        scrollToResults()
        return
      }

      const filters = activeFilters()
      const search = await pagefind.search(query, Object.keys(filters).length ? { filters } : undefined)
      if (token !== searchToken) return

      const results = await Promise.all(search.results.slice(0, 40).map((result) => result.data()))
      if (token !== searchToken) return

      if (results.length === 0) {
        searchEmpty.hidden = false
        status.textContent = 'Keine Treffer'
        scrollToResults()
        return
      }

      results.forEach((result) => {
        const url = resolveResultUrl(result.url)
        const meta = result.meta && result.meta.category ? result.meta.category : ''
        // Pagefind highlights matches, so its excerpt markup is inserted as is.
        appendResult(url, result.meta.title || 'Rezept', meta, result.excerpt)
      })

      status.textContent = results.length === 1 ? '1 Treffer' : results.length + ' Treffer'
      scrollToResults()
    }

    const onQueryChange = () => {
      beginResultsChange()
      const query = input.value.trim()
      if (query.length < 2) {
        showSections()
        scrollToResults()
        return
      }
      debounce = setTimeout(() => runSearch(query), 180)
    }

    input.addEventListener('input', onQueryChange)

    const updateFilteredResults = () => {
      paintButtons()
      if (input.value.trim().length >= 2) runSearch(input.value.trim())
      else {
        showSections()
        scrollToResults()
      }
    }

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        beginResultsChange()
        activeCategory = button.dataset.filterCategory || ''
        updateFilteredResults()
      })
    })

    tagButtons.forEach((button) => {
      button.addEventListener('click', () => {
        beginResultsChange()
        const tag = button.dataset.filterTag
        if (activeTags.has(tag)) activeTags.delete(tag)
        else activeTags.add(tag)
        updateFilteredResults()
      })
    })

    wipToggle.addEventListener('change', () => {
      beginResultsChange()
      showWip = wipToggle.checked
      try {
        localStorage.setItem(preferenceKey, String(showWip))
      } catch {
        // Keep the in-memory preference even when persistence is blocked.
      }
      updateFilteredResults()
    })

    // Restore the preference without scrolling or changing an incoming category anchor.
    applyFilters()

    resetButton?.addEventListener('click', () => {
      beginResultsChange()
      activeCategory = ''
      activeTags.clear()
      updateFilteredResults()
    })
  </script>
</section>

<style is:global>
  html:has(#rezepte [data-category-section]:target, #rezepte [data-empty-category]:target, #rezepte #noch-leer:target) {
    scroll-behavior: auto;
  }

  #rezepte [data-category-section],
  #rezepte [data-empty-category],
  #rezepte #noch-leer {
    scroll-margin-top: var(--recipe-anchor-margin, 7rem);
  }
</style>
