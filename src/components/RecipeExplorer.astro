---
import { Search, TestTubeDiagonal } from '@lucide/astro'
import { categories, tagVocabulary } from '../config/taxonomy'
import { withBase } from '../lib/url'
import TagChip from './TagChip.astro'
import CategoryIcon from './CategoryIcon.astro'

type Props = {
  total: number
  untestedCount: number
}

const { total, untestedCount } = Astro.props

const scrollRowClass =
  'no-scrollbar -mx-1 flex flex-nowrap items-center gap-2 overflow-x-auto px-1 pb-0.5 lg:mx-0 lg:px-0'
const chipClass =
  'focus-ring inline-flex shrink-0 items-center gap-1.5 whitespace-nowrap cursor-pointer rounded-full border border-rule bg-paper-raised px-3.5 py-1.5 text-xs font-semibold tracking-wide text-ink-soft transition-colors hover:text-ink'
---

<section
  id='rezepte'
  data-pagefind-url={withBase('pagefind/pagefind.js')}
  data-base-path={withBase()}
  class='mx-auto max-w-[75rem] scroll-mt-24 px-5 sm:px-8'>
  <div
    data-sticky-bar
    class='sticky top-18 z-20 -mx-5 border-b border-rule/80 bg-paper/85 px-5 py-3 backdrop-blur-md sm:-mx-8 sm:px-8'>
    <div class='flex flex-col gap-3'>
      <div class='flex flex-wrap items-center gap-3'>
        <label class='relative flex-1 min-w-[248px] sm:max-w-md'>
          <span class='sr-only'>Rezepte durchsuchen</span>
          <Search
            size={16}
            class='pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-ink-soft'
            aria-hidden='true'
            focusable='false'
          />
          <input
            id='rezept-suche'
            type='search'
            autocomplete='off'
            placeholder='Zutat oder Gericht suchen …'
            class='focus-ring w-full rounded-full border border-rule bg-paper-raised py-2.5 pr-4 pl-10 text-sm text-ink transition-colors placeholder:text-ink-soft/70 focus:border-accent'
          />
        </label>
        <p id='rezept-status' class='text-sm text-ink-soft tabular-nums' aria-live='polite'>
          {total} Rezepte
        </p>
        <span class='flex-1 -ml-3'></span>
        <label
          data-wip-control
          title='Versuchsküche anzeigen'
          class='flex justify-self-end min-h-9 cursor-pointer items-center gap-2 text-xs font-semibold text-ink-soft'
          hidden>
          <input id='show-wip' type='checkbox' role='switch' class='peer sr-only' />
          <span
            aria-hidden='true'
            class='relative h-6 w-11 shrink-0 rounded-full bg-rule transition-colors peer-checked:bg-accent peer-checked:text-accent peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-accent peer-checked:[&>span]:translate-x-5'>
            <span class='absolute top-0.5 left-0.5 flex size-5 items-center justify-center rounded-full bg-paper transition-transform'>
              <TestTubeDiagonal size={14} aria-hidden='true' focusable='false' />
            </span>
          </span>
          <span class='sr-only sm:not-sr-only'>
            Versuchsküche <span class='sm:hidden md:inline'>anzeigen ({untestedCount})</span>
          </span>
        </label>
      </div>

      <div class={scrollRowClass}>
        <button
          type='button'
          data-filter-category=''
          aria-pressed='true'
          class='focus-ring inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-full border border-transparent bg-ink px-3.5 py-1.5 text-xs font-semibold tracking-wide whitespace-nowrap text-paper'>
          Alle
        </button>
        {categories.map((category) => (
          <button
            type='button'
            data-filter-category={category.id}
            data-category-label={category.short}
            aria-pressed='false'
            class={chipClass}>
            <CategoryIcon category={category.id} />
            {category.short}
          </button>
        ))}
      </div>
    </div>
  </div>

  {/* Deliberately outside the sticky area: the tag row scrolls away so the
      pinned bar stays two rows tall. */}
  <div data-tag-row class='border-b border-rule/60 pt-4 pb-3'>
    <div class={scrollRowClass}>
      <span class='shrink-0 pr-1 text-[0.7rem] font-semibold tracking-[0.14em] text-ink-soft/80 uppercase'>
        Schlagworte
      </span>
      {tagVocabulary.map((tag) => (
        <button
          type='button'
          data-filter-tag={tag}
          aria-pressed='false'
          class='focus-ring shrink-0 cursor-pointer rounded-full'>
          <TagChip label={tag} interactive />
        </button>
      ))}
    </div>
  </div>

  <div id='suche-bereich' class='mt-8' hidden>
    <h2 class='font-display text-section font-semibold'>Suchergebnisse</h2>
    <ul id='suche-liste' class='mt-5 flex flex-col gap-2'></ul>
    <p id='suche-leer' class='mt-6 text-sm text-ink-soft' hidden>
      Keine Rezepte gefunden.
    </p>
  </div>

  <div id='rezept-liste' data-recipe-list class='mt-12'>
    <slot />
  </div>

  <script>
    import { initRecipeExplorer } from '../scripts/recipe-explorer'

    initRecipeExplorer()
  </script>
</section>

<style is:global>
  html:has(#rezepte) {
    scroll-behavior: auto;
  }

  /* Untested recipes are rendered visible so they stay reachable without
     JavaScript; the layout sets this flag from the stored preference before the
     first paint, and the controller keeps it in step with the toggle. */
  html[data-untested-hidden] #rezepte [data-untested] {
    display: none;
  }

  #rezepte [data-category-section],
  #rezepte [data-empty-category],
  #rezepte #noch-leer {
    scroll-margin-top: var(--recipe-anchor-margin, 7rem);
  }
</style>
