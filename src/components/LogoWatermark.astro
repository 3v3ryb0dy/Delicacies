---
import { withBase } from '../lib/url'

type Props = {
  /** `hero` sits behind the start page hero, `page` behind a recipe header. */
  tone?: 'hero' | 'page'
  /** Edge the mark bleeds off; also picks the direction the gradient dissolves. */
  side?: 'left' | 'right'
  class?: string
}

const { tone = 'hero', side = 'right', class: className } = Astro.props
---

<div
  data-watermark
  data-watermark-tone={tone}
  aria-hidden='true'
  class:list={[
    'logo-watermark pointer-events-none absolute hidden select-none sm:block',
    `logo-watermark-${tone}`,
    `logo-watermark-${side}`,
    className
  ]}
  style={`--watermark-image: url("${withBase('logo.svg')}")`}></div>

<style>
  /* The logo file is used as a mask so a single flat asset can carry a soft
     gradient in theme colours instead of a fixed fill. */
  .logo-watermark {
    background-image: linear-gradient(
      var(--watermark-angle, 155deg),
      var(--color-accent) 0%,
      var(--color-gold) 55%,
      transparent 100%
    );
    -webkit-mask-image: var(--watermark-image);
    mask-image: var(--watermark-image);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-size: contain;
    mask-size: contain;
    opacity: var(--watermark-opacity, 0.07);
    transform: translate3d(0, var(--watermark-shift, 0px), 0) rotate(var(--watermark-rotate, -8deg));
    will-change: transform;
  }

  .logo-watermark-hero {
    --watermark-opacity: 0.07;
    --watermark-rotate: -8deg;
  }

  .logo-watermark-page {
    --watermark-opacity: 0.055;
    --watermark-rotate: 4deg;
  }

  /* Bleed edge last, so the mark dissolves as it leaves the page. The
     gradient runs towards the edge the mark bleeds off, so a crop at the
     page border always lands in the already faded part of the letter. */
  .logo-watermark-right {
    --watermark-angle: 40deg;
  }

  .logo-watermark-left {
    --watermark-angle: 250deg;
  }

  @media (prefers-color-scheme: dark) {
    .logo-watermark-hero {
      --watermark-opacity: 0.12;
    }

    .logo-watermark-page {
      --watermark-opacity: 0.095;
    }
  }

  @media print {
    .logo-watermark {
      display: none;
    }
  }
</style>

<script>
  type Tone = 'hero' | 'page'

  type Mark = {
    element: HTMLElement
    tone: Tone
    top: number
    height: number
    visible: boolean
  }

  const marks = Array.from(document.querySelectorAll<HTMLElement>('[data-watermark]'))
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (marks.length > 0 && !prefersReducedMotion.matches) {
    const travel: Record<Tone, number> = { hero: 32, page: 18 }
    const turn: Record<Tone, number> = { hero: 3, page: 3 }
    const base: Record<Tone, number> = { hero: -8, page: 4 }

    /** Layout position in the document, unaffected by the mark's own transform. */
    const documentTop = (element: HTMLElement) => {
      let top = 0
      let node: HTMLElement | null = element
      while (node) {
        top += node.offsetTop
        node = node.offsetParent as HTMLElement | null
      }
      return top
    }

    const measure = (item: Mark) => {
      item.top = documentTop(item.element)
      item.height = item.element.offsetHeight
    }

    const items: Mark[] = marks.map((element) => {
      const tone: Tone = element.dataset.watermarkTone === 'page' ? 'page' : 'hero'
      const item: Mark = {
        element,
        tone,
        top: 0,
        height: 0,
        visible: true
      }
      measure(item)
      return item
    })

    let frame = 0

    const update = () => {
      frame = 0
      const scrollY = window.scrollY
      const viewport = window.innerHeight

      for (const { element, tone, top, height, visible } of items) {
        if (!visible || height === 0) continue

        // 0 when the mark enters at the bottom edge, 1 once it has fully passed
        // the top. Bounded by the viewport, so long pages drift at the same rate.
        const raw = (scrollY - (top - viewport)) / (viewport + height)
        const progress = Math.min(1, Math.max(0, raw))

        const shift = (progress - 0.5) * 2 * travel[tone]
        const rotation = base[tone] + progress * turn[tone]

        element.style.setProperty('--watermark-shift', `${shift.toFixed(2)}px`)
        element.style.setProperty('--watermark-rotate', `${rotation.toFixed(2)}deg`)
      }
    }

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update)
    }

    // Only touch the transform while a mark is anywhere near the viewport.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const item = items.find((candidate) => candidate.element === entry.target)
          if (item) item.visible = entry.isIntersecting
        }
        schedule()
      },
      { rootMargin: '200px 0px' }
    )

    for (const item of items) observer.observe(item.element)

    const remeasure = () => {
      for (const item of items) measure(item)
      schedule()
    }

    window.addEventListener('scroll', schedule, { passive: true })
    window.addEventListener('resize', remeasure)
    document.fonts?.ready.then(remeasure)

    update()
  }
</script>
