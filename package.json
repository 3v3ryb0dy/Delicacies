{
  "name": "delicacies",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "prepare": "node scripts/install-hooks.mjs",
    "prebuild": "node scripts/generate-readme.mjs",
    "build": "astro build && pagefind --site dist && node scripts/verify-built-site.mjs",
    "preview": "astro preview",
    "readme": "node scripts/generate-readme.mjs",
    "images:webp": "node scripts/convert-recipe-images.mjs",
    "test": "node --test src/lib/*.test.mjs scripts/lib/*.test.mjs",
    "check": "npm test && node scripts/generate-readme.mjs --check && node scripts/check-recipes.mjs && astro check && prettier --check .",
    "ci": "npm run check && npm run build",
    "verify:site": "node scripts/verify-built-site.mjs",
    "format": "prettier --write .",
    "format:staged": "node scripts/format-staged.mjs",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/nunito-sans": "^5.2.5",
    "@lucide/astro": "^1.46.0",
    "@tailwindcss/typography": "^0.5.16",
    "astro": "^7.3.2",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.2"
  }
}
